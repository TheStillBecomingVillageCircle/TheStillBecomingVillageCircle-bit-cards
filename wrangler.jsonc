{
  "name": "thestillbecomingvillagecircle-bit-cards",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.jpeg"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
